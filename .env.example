# Public origin embedded in certificate QR codes. Set this to the deployed
# origin for production; do not use a localhost value for issued certificates.
VITE_PUBLIC_APP_URL=https://accumate.vercel.app

# Required for cross-device public lookups. Use the Supabase project's public
# URL and anon key; the public RPC only returns the verification-safe fields.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
